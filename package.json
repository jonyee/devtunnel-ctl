{
  "name": "devtunnel-ctl",
  "version": "0.1.0",
  "private": true,
  "description": "Resilient SSH forwarding using the Microsoft Dev Tunnels SDK",
  "type": "module",
  "bin": { "devtunnel-ctl": "dist/main.js" },
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc && chmod +x dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "1.3.61",
    "@microsoft/dev-tunnels-contracts": "1.3.61",
    "@microsoft/dev-tunnels-management": "1.3.61",
    "@microsoft/dev-tunnels-ssh": "3.12.42"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
